#!/usr/bin/env bash
# Deploys one commit of main from its GHCR image. Installed as root at
# /usr/local/bin/tierus-deploy (a commit must not change what the deploy key
# can do) and run by the deploy key's forced command, which passes the commit
# id in SSH_ORIGINAL_COMMAND. GitHub Actions sends "<user>\n<token>" on stdin
# to pull the private image; the token lives only for that job.
# By hand (after `docker login ghcr.io`): tierus-deploy <commit>
set -euo pipefail

APP_DIR=${TIERUS_DIR:-/srv/tierus}
IMAGE=${TIERUS_IMAGE:-ghcr.io/groupe-a-bingo/tierus}

sha=${SSH_ORIGINAL_COMMAND-${1:-}}
if [[ ! $sha =~ ^[0-9a-f]{40}$ ]]; then
  echo "usage: tierus-deploy <40-character commit id>" >&2
  exit 2
fi

cd "$APP_DIR"
exec 9>.deploy.lock
flock 9 # one deploy at a time

# Pull first: a missing image leaves the running version as is.
user="" token=""
if [[ ! -t 0 ]]; then
  IFS= read -r -t 10 user || true
  IFS= read -r -t 10 token || true
fi
if [[ -n $token ]]; then
  cfg=$(mktemp -d)
  trap 'rm -rf "$cfg"' EXIT
  printf '%s' "$token" | DOCKER_CONFIG=$cfg docker login ghcr.io -u "${user:-github-actions}" --password-stdin >/dev/null
  DOCKER_CONFIG=$cfg docker pull --quiet "$IMAGE:$sha"
  rm -rf "$cfg"
else
  docker pull --quiet "$IMAGE:$sha"
fi

# A slow run for an older commit must not undo a newer deploy. Going back on
# purpose: ALLOW_OLDER=1 tierus-deploy <commit> (the SSH key cannot set it).
new_time=$(docker image inspect -f '{{index .Config.Labels "dev.tierus.commit-time"}}' "$IMAGE:$sha")
cur_time=$(cat .deployed-time 2>/dev/null || echo 0)
[[ $new_time =~ ^[0-9]+$ ]] || new_time=0
[[ $cur_time =~ ^[0-9]+$ ]] || cur_time=0
current=$(cat .deployed 2>/dev/null || echo none)
if [[ $current != "$sha" && ${ALLOW_OLDER:-} != 1 && ${new_time:-0} -lt $cur_time ]]; then
  echo "skipped: $current is newer than $sha"
  exit 0
fi
echo "deploying $sha (was $current)"

# The compose file shipped in the image always matches it.
cid=$(docker create "$IMAGE:$sha")
docker cp "$cid:/app/docker-compose.yml" docker-compose.yml.new >/dev/null
docker rm "$cid" >/dev/null
mv docker-compose.yml.new docker-compose.yml

# Remember the image in .env, so manual `docker compose` commands use it too.
tmp=$(mktemp .env.XXXXXX)
{ grep -v '^APP_IMAGE=' .env 2>/dev/null || true; echo "APP_IMAGE=$IMAGE:$sha"; } > "$tmp"
chmod 600 "$tmp"
mv "$tmp" .env
export APP_IMAGE="$IMAGE:$sha"

fail() {
  docker compose ps -a
  docker compose logs --tail 80 migrate app
  echo "deploy of $sha failed: see the logs above" >&2
  exit 1
}
# Migrations run first (the migrate service), then app and worker.
docker compose up -d --no-build --remove-orphans || fail

# Wait until the app answers (anything below 500).
for _ in $(seq 60); do
  if docker compose exec -T app node -e \
    "fetch('http://127.0.0.1:3010/').then(r=>process.exit(r.status<500?0:1),()=>process.exit(1))" 2>/dev/null; then
    echo "$sha" > .deployed
    echo "${new_time:-0}" > .deployed-time
    # Old images of this app, then untagged leftovers. Volumes are never touched.
    docker images "$IMAGE" --format '{{.Repository}}:{{.Tag}}' \
      | grep -vxF "$IMAGE:$sha" | xargs -r docker rmi >/dev/null 2>&1 || true
    docker image prune -f >/dev/null
    echo "deployed $sha"
    exit 0
  fi
  sleep 3
done
fail
