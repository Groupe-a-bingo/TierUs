POSTGRES_USER=tierus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tierus
DATABASE_URL=postgres://tierus:change-me@127.0.0.1:54329/tierus

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3010


# Where uploaded avatars are stored (local disk, no S3)
STORAGE_DIR=./storage

# Header holding the real client IP, set by your proxy (e.g. cf-connecting-ip
# behind Cloudflare, x-real-ip behind nginx). Required in production (or TRUSTED_PROXIES).
# The app trusts it blindly: it must only be reachable through that proxy.
CLIENT_IP_HEADER=

# docker compose: interface the app port is published on. Keep 127.0.0.1 when the
# proxy / tunnel runs on this host; 0.0.0.0 only behind a firewall that lets the
# proxy alone reach port 3010.
APP_BIND=127.0.0.1

# Only used when CLIENT_IP_HEADER is empty: exact IPs of your reverse proxies
TRUSTED_PROXIES=

# Extra public origins (comma-separated), e.g. a Cloudflare tunnel
EXTRA_ORIGINS=
