POSTGRES_USER=tierus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tierus
DATABASE_URL=postgres://tierus:change-me@127.0.0.1:54329/tierus

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3010


# Where uploaded avatars are stored (local disk, no S3)
STORAGE_DIR=./storage

# Timezone used to decide "today" for daily tier lists
APP_TIMEZONE=Europe/Paris

# Header holding the real client IP, set by your proxy (e.g. cf-connecting-ip
# behind Cloudflare, x-real-ip behind nginx). Strongly recommended in production.
CLIENT_IP_HEADER=

# Only used when CLIENT_IP_HEADER is empty: exact IPs of your reverse proxies
TRUSTED_PROXIES=

# Extra public origins (comma-separated), e.g. a Cloudflare tunnel
EXTRA_ORIGINS=
